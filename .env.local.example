# 이 파일은 전부 선택 사항입니다. 아무것도 넣지 않아도 앱은 그대로 돌아갑니다.
# 기본 배경지도는 OpenFreeMap(키 없음, 사용량 제한 없음),
# 기본 검색은 OpenStreetMap Nominatim + Photon(키 없음) 입니다.

# (선택) 브이월드 인증키. 넣으면 두 가지가 같이 좋아집니다.
#   1) 배경지도를 국토교통부 브이월드로 전환하는 버튼이 생깁니다
#   2) 검색이 정부 도로명주소 DB를 함께 뒤져 건물명(예: 거봉INC)까지 찾습니다
# 발급: https://www.vworld.kr/dev/v4api.do → 인증키 발급 → 도메인에 localhost 등록
#
# 지도 타일은 브라우저가 직접 부르므로 NEXT_PUBLIC_ 이 필요합니다.
NEXT_PUBLIC_VWORLD_KEY=
# 검색은 서버에서 부릅니다. 비워 두면 위의 NEXT_PUBLIC_VWORLD_KEY 를 그대로 씁니다.
# 키를 노출하고 싶지 않으면 검색 전용 키를 따로 발급해 여기에만 넣으세요.
VWORLD_KEY=
# 브이월드는 등록한 도메인에서만 키를 받아 줍니다. 서버가 보내는 Referer 를 바꿔야 할 때만 씁니다.
# 비워 두면 앱이 떠 있는 주소를 그대로 씁니다.
VWORLD_REFERER=

# (선택) 장소 검색을 네이버 지역검색 API로 쓰고 싶을 때.
# 넣으면 이쪽만 씁니다. 상호 검색은 가장 정확하지만 순수 주소 검색은 약합니다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# (선택) 국토교통부 TAGO 버스 정보. 넣으면 시내·마을버스 노선이 들어온다.
# OpenStreetMap 에는 국내 버스 노선이 거의 없어서, 키가 없으면 지하철만 안내한다.
# 발급: https://www.data.go.kr → "TAGO_버스정류소정보"·"TAGO_버스노선정보" 활용신청
# 공공데이터포털이 주는 "일반 인증키(Encoding)" 를 그대로 붙여 넣는다 (%2B, %3D 가 섞인 문자열).
TAGO_KEY=

# (선택) 서울 버스. 노선·정류장 순서는 서울 TOPIS(ws.bus.go.kr)에서 오고, 인증키는
# 공공데이터포털 것을 쓴다. 비워 두면 TAGO_KEY 를 그대로 쓴다.
# data.go.kr 에서 "서울특별시_정류소정보조회 서비스", "서울특별시_노선정보조회 서비스" 를
# 활용신청해야 열린다. 신청 전에는 401 이 오고, 그 사유가 화면에 뜬다.
SEOUL_BUS_KEY=

# (선택) 서울 열린데이터광장(data.seoul.go.kr) 인증키. 지금은 길찾기에 쓰지 않는다.
SEOUL_OPENAPI_KEY=
SEOUL_CITYDATA_KEY=
